# Turkish Benchmark System - API Keys Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Together.ai API Key (https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# Google Gemini API Key (https://ai.google.dev/)
GEMINI_API_KEY=

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# HuggingFace Token (optional, for private/gated models)
# HF_TOKEN=

# --- Judge (Puanlama) Ayarları ---
# Varsayılan judge provider ve modeli .env üzerinden ayarlayabilirsiniz.
# CLI'den --judge-provider ve --judge-model ile de geçersiz kılınabilir.
# Desteklenen provider'lar: openai, anthropic, together, gemini, openrouter, ollama, lmstudio
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o
